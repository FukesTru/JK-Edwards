# Copy to .env.local for local development, and set the same values in your
# hosting provider (e.g. Vercel → Project → Settings → Environment Variables).
# Business details (name, phone, prices, domain, booking and upload links)
# live in site.config.ts, not here.

# --- Analytics ---------------------------------------------------------------
# GA4 measurement ID. While this is the placeholder, the gtag snippet renders
# but gtag.js is not loaded, so nothing is tracked.
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# --- Placeholders ------------------------------------------------------------
# Unconfirmed copy ([CLIENT TO CONFIRM], {{PLACEHOLDERS}}) gets a dashed amber
# outline for review. Set to "false" for launch.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=true

# --- Form delivery (configure at least one before launch) --------------------
# Without a channel, forms log to the console in development and show a
# "please try again / call us" error in production.

# POST each lead as JSON to a CRM / automation webhook (GoHighLevel, Zapier, Make…)
CONTACT_WEBHOOK_URL=

# …and/or email each lead through Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Website <web@yourdomain.com>"
