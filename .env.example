# Copy to .env.local for local development, and set the same values in your
# hosting provider (e.g. Vercel → Project → Settings → Environment Variables).

# --- Analytics -------------------------------------------------------------
# GA4 measurement ID. While this is the placeholder, the gtag snippet is
# rendered but gtag.js is not loaded, so nothing is tracked.
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# --- Scheduling ------------------------------------------------------------
# Calendly / GoHighLevel booking page embedded on /contact. Leave empty to
# hide the scheduler (a placeholder shows while placeholders are visible).
NEXT_PUBLIC_BOOKING_URL=

# --- Placeholders ------------------------------------------------------------
# Unconfirmed copy ([X]+ years, bios, hours, eBooks…) renders with a dashed
# amber outline for review. Set to "false" for launch.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=true

# --- Form delivery (configure at least one before launch) -------------------
# Without a channel, forms log to the console in development and show a
# "please call us" error in production.

# POST each lead as JSON to a CRM / automation webhook (GoHighLevel, Zapier, Make…)
CONTACT_WEBHOOK_URL=

# …and/or email each lead through Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@jkedwards.com
CONTACT_FROM_EMAIL="JK Edwards Website <web@jkedwards.com>"
